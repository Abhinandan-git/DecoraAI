# ─────────────────────────────────────────────────────────────────────────────
# DecoraAI Backend — Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME="DecoraAI API"
APP_VERSION="0.0.1"
DEBUG=true

# ── Security ──────────────────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=dev-secret-change-in-production-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7

# ── DATABASE ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://auth_database_a8gh_user:IuPSX8hoodtpEvxsJGYgHR31rgUr9xZ0@dpg-d7rqplrt6lks73fs7idg-a.ohio-postgres.render.com/auth_database_a8gh

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=["http://localhost:3000"]

# ── Diffusion model ───────────────────────────────────────────────────────────
# Set to false to skip model loading (useful in dev without a GPU)
MODEL_ENABLED=false

# Base Stable Diffusion model — HuggingFace repo ID or absolute local path
# Examples:
#   SD_BASE_MODEL=runwayml/stable-diffusion-v1-5
#   SD_BASE_MODEL=/models/stable-diffusion-v1-5
SD_BASE_MODEL=runwayml/stable-diffusion-v1-5

# Path to your LoRA weights.
# Can be a directory (containing adapter_model.safetensors + adapter_config.json)
# or the direct path to a .safetensors file.
LORA_WEIGHTS_PATH=./assets/lora

# Name used internally to reference the loaded adapter (no spaces)
LORA_ADAPTER_NAME=floorplan_lora

# How strongly your LoRA influences the output (0.0 = base model, 1.0 = full LoRA)
LORA_SCALE=0.85

# Default generation parameters (can be overridden per-request)
IMAGE_WIDTH=512
IMAGE_HEIGHT=512
IMAGE_STEPS=30
IMAGE_GUIDANCE_SCALE=7.5

# Device: auto | cuda | mps | cpu
# "auto" detects CUDA → MPS → CPU in that order
DEVICE=auto

# ── Chat ──────────────────────────────────────────────────────────────────────
# Set to true and fill in the relevant key once you wire up an LLM
CHAT_ENABLED=false

# OpenAI (uncomment if using)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o

# Anthropic (uncomment if using)
# ANTHROPIC_API_KEY=sk-ant-...
